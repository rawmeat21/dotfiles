{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 6,
    "margin-top": 0,
    "margin-bottom": 0,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
	"mpris", 
	"pulseaudio",
	"custom/music"
    ],
    "modules-center": [
        "clock#time",
        "custom/logo",
        "clock#date"
    ],
    "modules-right": [
        "custom/updates",
        "cpu",
        "memory",
        "bluetooth",
        "network",
        "custom/volume",
        "battery",
        "custom/power"
    ],
    "custom/arch": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "custom/logo": {
        "format": "󰣇",
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%A, %B %d}",
        "tooltip": false
    },
    "custom/updates": {
        "format": "󰚰 {}",
        "exec": "checkupdates | wc -l",
        "interval": 3600,
        "on-click": "kitty -e sudo pacman -Syu",
        "tooltip": true,
        "tooltip-format": "{} updates available"
    },
    "custom/music": {
        "format": "󰝚",
        "on-click": "kitty --class ytfzf-search -e ytfzfplay",
        "tooltip": true,
        "tooltip-format": "Search YouTube Music"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": false
    },
    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "tooltip": false
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "on-click": "kitty -e ~/.config/waybar/scripts/bluetooth",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\n{num_connections} connected"
    },
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤮 off",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "kitty -e ~/.config/waybar/scripts/network",
        "tooltip": true,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip": false
    },
    "custom/volume": {
        "exec": "~/.config/waybar/scripts/volume.sh",
        "interval": 1,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "kitty --class powermenu -e ~/.config/hypr/scripts/powermenu.sh",
        "tooltip": false
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    }
}
