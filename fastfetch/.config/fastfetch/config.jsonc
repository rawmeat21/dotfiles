{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "imports": ["colors.jsonc"],
  "display": {
    "separator": " → ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "logo": {
    "type": "small",
    "padding": {
        "top": 1
    }
  },
  "modules": [
    "os",
    "kernel",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "battery",
    "uptime"
  ]
}
